{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.1",
  "author": "Kemal Aslıyüksek",
  "homepage_url": "https://github.com/kemalasliyuksek/thunderbird-tray",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-tray@kemalasliyuksek.com",
      "strict_min_version": "140.0",
      "strict_max_version": "160.*"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["accountsRead", "messagesRead", "compose", "nativeMessaging", "storage"],
  "experiment_apis": {
    "windowTray": {
      "schema": "experiments/windowTray/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "events": ["startup"],
        "paths": [["windowTray"]],
        "script": "experiments/windowTray/implementation.js"
      }
    }
  }
}
